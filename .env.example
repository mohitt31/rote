# Copy to .env yourself. Never commit .env or paste keys into chat.
# Use a Google project with billing disabled / free quota only.
# Canonical framework name (GEMINI_API_KEY is also a supported alias).
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional backup; leave blank unless using Groq's free plan.
GROQ_API_KEY=

# Select a provider explicitly. Choose an available Flash-Lite model in Settings.
AGENT_ENGINE=ai-sdk:google
# AGENT_MODEL=<available-free-tier-flash-lite-model-id>

# Local PostgreSQL is embedded (PGlite) when DATABASE_URL is unset.
# Leave production values unset until deployment is approved.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
# BETTER_AUTH_SECRET=<generate-locally-before-approved-deployment>
# APP_URL=https://<approved-host>
# AUTH_DISABLED is deliberately unset. Use Continue as local dev on loopback.
