#!/bin/sh
set -eu
ROTE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROTE_ROOT"
mkdir -p .bootstrap work/tmp
export npm_config_cache="$ROTE_ROOT/.bootstrap/npm-cache"
export TMPDIR="$ROTE_ROOT/work/tmp"
npm install --prefix .bootstrap --no-audit --no-fund node@22.22.0 pnpm@10.34.9
exec sh scripts/local pnpm install --frozen-lockfile
